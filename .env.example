# Discord bot token (Developer Portal -> Bot -> Token)
TOKEN=your_bot_token_here

# Channel ID the bot mirrors search requests into
LOG_CHANNEL_ID=123456789012345678

# PostgreSQL connection. The bot and the postgres container share these:
# the official postgres image reads POSTGRES_DB/USER/PASSWORD to create the
# database, and the bot assembles its connection URL from the same values.
# POSTGRES_HOST is the compose service name inside the network ("postgres");
# use "localhost" only when running the bot outside Docker against a local DB.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=paradox
POSTGRES_USER=paradox
POSTGRES_PASSWORD=change_me

# Optional: a full SQLAlchemy/asyncpg URL. When set it overrides the POSTGRES_*
# parts above (handy for a managed database). Example:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/paradox
DATABASE_URL=

# Where runtime logs live. Docker mounts this as a volume so they survive a
# redeploy; "." locally.
DATA_DIR=.

# Command prefix. Commands are case-insensitive, so -eu4 and -EU4 both work.
BOT_PREFIX=-

# Port for the keep-alive HTTP endpoint
PORT=8080

# Optional: a guild (server) ID for instant /admin command sync while
# developing. Without it, slash commands sync globally and can take up to an
# hour to appear. Right-click your test server -> Copy Server ID (needs
# Developer Mode on in Discord settings).
DEV_GUILD_ID=

# pdx.tools upload credentials (Account -> API key on https://pdx.tools).
# Leave empty to disable the -tools upload; the bot will say so instead of
# pretending the file was uploaded.
PDX_TOOLS_USER_ID=
PDX_TOOLS_API_KEY=
PDX_TOOLS_API_URL=https://pdx.tools/api/saves
# Docs (https://pdx.tools/docs/api/) only document EU4 uploads; change the
# game segment here if pdx.tools adds other games.
PDX_TOOLS_SAVE_URL=https://pdx.tools/eu4/saves/{save_id}

# Optional: channel for the daily auto-posted random-article "fact of the
# day" (12:00 UTC). Leave empty to disable.
DAILY_FACT_CHANNEL_ID=
